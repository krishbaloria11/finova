# Finova Silk & Glass - Environment Configuration Template
# Duplicate this file to .env and adjust variables as required

DJANGO_SECRET_KEY=finova-insecure-development-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Engine: 'sqlite' or 'postgresql'
DB_ENGINE=sqlite

# If DB_ENGINE=postgresql, configure below:
DB_NAME=finova_db
DB_USER=finova_user
DB_PASSWORD=finova_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
